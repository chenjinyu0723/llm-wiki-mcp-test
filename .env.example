# 验证项目自身的监听地址；模型密钥不应写入本文件。
VALIDATOR_HOST=127.0.0.1
VALIDATOR_PORT=8044

# 两个 LLM Wiki Streamable HTTP MCP 的地址。
VALIDATOR_PUBLIC_MCP_URL=http://127.0.0.1:8030/mcp
VALIDATOR_ADMIN_MCP_URL=http://127.0.0.1:8031/mcp

# 浏览器上传资料的临时目录。管理员 MCP 必须和本项目运行在同一台机器，
# 因为它接收的是管理员主机上的绝对文件路径。
VALIDATOR_UPLOAD_DIR=data/uploads
VALIDATOR_DATA_DIR=data

# 单轮对话模型的最长等待时间与建连后重试次数。模型凭据由浏览器会话填写，
# 不会写入这里或 SQLite 数据库。
VALIDATOR_CHAT_TIMEOUT_SECONDS=600
VALIDATOR_CHAT_MAX_RETRIES=2

# 注意：这里不配置 EMBEDDING_* 或 VISION_*。
# Embedding 属于主项目 Chroma 索引的固定向量空间，视觉模型属于管理员 MCP
# 的文档解析流程；它们必须配置在 ../llm-wiki-web/backend/.env 中。
# 验证台只通过 MCP 间接使用这两类模型。
